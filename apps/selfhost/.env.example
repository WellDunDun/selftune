# Generate with: openssl rand -hex 32
SELFTUNE_AUTH_TOKEN=

SELFTUNE_SELFHOST_ADMIN_EMAIL=admin@example.com
SELFTUNE_SELFHOST_ADMIN_NAME=SelfTune Admin
SELFTUNE_SELFHOST_ADMIN_ORG_NAME=My Team

# The browser origin users will open. Put TLS in front before exposing publicly.
SELFTUNE_PUBLIC_URL=http://localhost:8787
SELFTUNE_PORT=8787

# Optional additional accounts for private sharing. Each account needs a unique token.
# SELFTUNE_SELFHOST_USERS_JSON=[{"email":"teammate@example.com","name":"Teammate","org_name":"Teammate","role":"member","token":"replace-with-another-32-character-token"}]

# Optional comma-separated browser origins allowed to call the Remote Library API.
# SELFTUNE_ALLOWED_ORIGINS=https://desktop.example.com

# Optional immutable object limit. Default: 52428800 (50 MiB).
# SELFTUNE_REMOTE_LIBRARY_MAX_OBJECT_BYTES=52428800
