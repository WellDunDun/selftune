{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "bun-types"]
  },
  "include": [
    "src",
    "scripts",
    "electron.vite.config.ts",
    "electron-builder.config.ts",
    "electron-builder.e2e.config.ts"
  ]
}
