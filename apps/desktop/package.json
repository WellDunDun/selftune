{
  "name": "@selftune/desktop",
  "version": "0.4.3",
  "private": true,
  "description": "Native desktop control plane for SelfTune skill observability and improvement",
  "homepage": "https://selftune.dev",
  "license": "MIT",
  "author": {
    "name": "SelfTune contributors",
    "email": "oss-sync@selftune.dev"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build:ui": "bun run --cwd ../local-dashboard build",
    "build:sidecar": "bun run scripts/build-sidecar.ts",
    "build:icon:mac": "bun run scripts/build-mac-icon.ts",
    "build": "bun run build:ui && bun run build:sidecar && electron-vite build",
    "package": "bun run build && electron-builder --config electron-builder.config.ts",
    "package:mac": "bun run build && electron-builder --mac --config electron-builder.config.ts",
    "package:win": "bun run build && electron-builder --win --config electron-builder.config.ts",
    "package:linux": "bun run build && electron-builder --linux --config electron-builder.config.ts",
    "package:e2e": "electron-builder --dir --config electron-builder.e2e.config.ts",
    "smoke:packaged": "tsx scripts/smoke-packaged.ts",
    "smoke:sidecar": "bun run scripts/smoke-sidecar.ts",
    "smoke:sidecar-duckdb": "bun run scripts/smoke-sidecar-duckdb.ts",
    "smoke:sidecar-package-collector": "bun run scripts/smoke-sidecar-package-collector.ts",
    "test": "bun test src/main/*.test.ts scripts/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@selftune/config": "workspace:*",
    "@sentry/electron": "^7.8.0",
    "@zip.js/zip.js": "^2.8.17",
    "effect": "4.0.0-beta.66",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.4.5-r.1",
    "@selftune/local": "workspace:*",
    "@selftune/runtime": "workspace:*",
    "@types/node": "^20",
    "bun-types": "^1.3.11",
    "electron": "41.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "playwright": "1.61.1",
    "tsx": "4.20.6",
    "typescript": "^5.9.3"
  }
}
