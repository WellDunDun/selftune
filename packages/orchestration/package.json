  },
  "dependencies": {
    "@selftune/harness-claude-code": "workspace:*",
    "@selftune/harness-codex": "workspace:*",
    "@selftune/harness-openclaw": "workspace:*",
    "@selftune/harness-opencode": "workspace:*",
    "@selftune/harness-pi": "workspace:*",
    "@selftune/runtime": "workspace:*",
    "@selftune/telemetry-contract": "workspace:*",
    "effect": "4.0.0-beta.66"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.66",
    "@types/bun": "^1.3.11",
    "bun-types": "^1.3.11",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18"
  }
