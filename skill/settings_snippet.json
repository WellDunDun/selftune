{
  "_readme": "Merge the 'hooks' block below into your ~/.claude/settings.json",
  "_readme2": "Replace /PATH/TO/ with the actual directory where you saved the scripts",
  "_readme3": "This is the comprehensive template. Portable single-skill and multi-skill variants are bundled in assets/",
  "_readme4": "Keep both Read and Skill in the skill-eval matcher: Skill records invocation intent and Read supplies the installed skill path for exact package hashing.",
  "_readme5": "Desktop packaging rewrites these source commands to the signed SelfTune executable using `selftune hook <name>`; do not add per-hook binaries.",

  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun /PATH/TO/bin/run-hook.cjs /PATH/TO/cli/selftune/hooks/prompt-log.ts",
            "timeout": 5,
            "statusMessage": "selftune: logging prompt"
          },
          {
            "type": "command",
            "command": "bun /PATH/TO/bin/run-hook.cjs /PATH/TO/cli/selftune/hooks/auto-activate.ts",
            "timeout": 5,
            "statusMessage": "selftune: checking activation rules"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Write(*SKILL.md)",
            "command": "bun /PATH/TO/bin/run-hook.cjs /PATH/TO/cli/selftune/hooks/skill-change-guard.ts",
            "timeout": 5,
            "statusMessage": "selftune: checking skill change guard"
          },
          {
            "type": "command",
            "if": "Edit(*SKILL.md)",
            "command": "bun /PATH/TO/bin/run-hook.cjs /PATH/TO/cli/selftune/hooks/skill-change-guard.ts",
            "timeout": 5,
            "statusMessage": "selftune: checking skill change guard"
          },
          {
            "type": "command",
            "if": "Write(*SKILL.md)",
            "command": "bun /PATH/TO/bin/run-hook.cjs /PATH/TO/cli/selftune/hooks/evolution-guard.ts",
            "timeout": 5,
            "statusMessage": "selftune: checking evolution guard"
          },
          {
            "type": "command",
            "if": "Edit(*SKILL.md)",
            "command": "bun /PATH/TO/bin/run-hook.cjs /PATH/TO/cli/selftune/hooks/evolution-guard.ts",
            "timeout": 5,
            "statusMessage": "selftune: checking evolution guard"
          },
          {
            "type": "command",
            "if": "Write(*SKILL.md)",
            "command": "bun /PATH/TO/bin/run-hook.cjs /PATH/TO/cli/selftune/hooks/skill-edit-capture.ts",
            "timeout": 5,
            "statusMessage": "selftune: capturing skill revision"
          },
          {
            "type": "command",
            "if": "Edit(*SKILL.md)",
            "command": "bun /PATH/TO/bin/run-hook.cjs /PATH/TO/cli/selftune/hooks/skill-edit-capture.ts",
            "timeout": 5,
            "statusMessage": "selftune: capturing skill revision"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun /PATH/TO/bin/run-hook.cjs /PATH/TO/cli/selftune/hooks/skill-edit-capture.ts",
            "timeout": 5,
            "statusMessage": "selftune: recording skill edit result"
          }
        ]
      },
      {
        "matcher": "Read|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bun /PATH/TO/bin/run-hook.cjs /PATH/TO/cli/selftune/hooks/skill-eval.ts",
            "timeout": 5,
            "statusMessage": "selftune: evaluating skill usage"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun /PATH/TO/bin/run-hook.cjs /PATH/TO/cli/selftune/hooks/commit-track.ts",
            "timeout": 8,
            "statusMessage": "selftune: tracking git commit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun /PATH/TO/bin/run-hook.cjs /PATH/TO/cli/selftune/hooks/session-stop.ts",
            "timeout": 60,
            "async": true,
            "statusMessage": "selftune: capturing session telemetry"
          }
        ]
      }
    ]
  }
}
