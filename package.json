{
  "name": "selftune",
  "version": "0.2.33",
  "description": "Skill-level observability and self-improvement for AI agents — monitors skill routing, detects missed triggers, and evolves descriptions automatically",
  "keywords": [
    "agent",
    "agent-skills",
    "ai-agent",
    "ai-observability",
    "bun",
    "claude-code",
    "cli",
    "cline",
    "codex",
    "eval",
    "evals",
    "evolution",
    "grading",
    "llm",
    "observability",
    "opencode",
    "self-improving",
    "selftune",
    "skill",
    "skill-evals",
    "skill-observability",
    "skill-routing",
    "skill-testing",
    "telemetry",
    "typescript"
  ],
  "homepage": "https://selftune.dev",
  "bugs": {
    "url": "https://github.com/selftune-dev/selftune/issues"
  },
  "license": "MIT",
  "author": "Daniel Petro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selftune-dev/selftune.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/WellDunDun"
  },
  "bin": {
    "selftune": "bin/selftune.cjs"
  },
  "workspaces": [
    "packages/*",
    "packages/*/*",
    "apps/*"
  ],
  "files": [
    "assets/",
    "bin/",
    "cli/selftune/",
    "apps/cli/package.json",
    "apps/cli/src/",
    "apps/local-dashboard/dist/",
    "templates/",
    "skill/",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@selftune/local-dashboard",
    "dev:server": "sh -c 'dashboard_port=${DASHBOARD_PORT:-7888}; bun --watch run apps/local/src/dashboard-server.ts --port $dashboard_port --runtime-mode dev-server'",
    "dev:dashboard": "sh -c 'dashboard_port=${DASHBOARD_PORT:-7888}; bun run apps/cli/src/main.ts dashboard --port $dashboard_port --no-open'",
    "lint": "bunx oxlint",
    "lint:fix": "bunx oxlint --fix",
    "format": "bunx oxfmt",
    "format:check": "bunx oxfmt --check",
    "lint:arch": "bun run lint-architecture.ts",
    "test": "turbo run test --filter=@selftune/runtime --filter=@selftune/orchestration --filter=@selftune/local --filter=@selftune/control-plane --filter='./packages/harnesses/*'",
    "test:legacy": "bun test tests/ packages/telemetry-contract/ --path-ignore-patterns='packages/control-plane/**'",
    "test:fast": "bun test $(find tests -name '*.test.ts' ! -name 'evolve.test.ts' ! -name 'integration.test.ts' ! -name 'dashboard-server.test.ts' ! -path '*/blog-proof/*')",
    "test:slow": "bun test tests/evolution/evolve.test.ts tests/evolution/integration.test.ts tests/monitoring/integration.test.ts tests/dashboard/dashboard-server.test.ts",
    "build:dashboard": "cd apps/local-dashboard && bunx vite build",
    "changeset": "changeset",
    "changeset:version": "changeset version && bun run scripts/release-version.ts sync-from-desktop && bun run sync-version && bun install --lockfile-only --ignore-scripts && bun run scripts/release-version.ts check --stable",
    "smoke:credentials": "bun run scripts/smoke-credential-store.ts",
    "smoke:package": "bun run scripts/smoke-packed-package.ts",
    "pack:release": "bun run scripts/pack-package.ts",
    "prepack": "node scripts/publish-package-json.cjs prepare",
    "postpack": "node scripts/publish-package-json.cjs restore",
    "link:claude-workspace": "bash scripts/link-claude-workspace.sh",
    "sync-version": "bun run scripts/sync-skill-version.ts",
    "validate:subagents": "bun run scripts/validate-subagent-docs.ts",
    "prepublishOnly": "bun run sync-version && bun run build:dashboard",
    "typecheck": "turbo run typecheck --filter=@selftune/runtime --filter=@selftune/orchestration --filter=@selftune/local --filter=@selftune/cli --filter=@selftune/control-plane --filter='./packages/harnesses/*'",
    "typecheck:runtime": "bun run --cwd packages/runtime typecheck",
    "typecheck:dashboard": "cd apps/local-dashboard && bunx tsc --noEmit",
    "check": "bun run lint && bun run format:check && bun run lint:arch && bun run typecheck && bun run typecheck:dashboard && bun run test",
    "prepare": "bunx lefthook install || true",
    "start": "bun run apps/cli/src/main.ts --help"
  },
  "dependencies": {
    "@selftune/control-plane": "workspace:*",
    "@selftune/harness-claude-code": "workspace:*",
    "@selftune/harness-cline": "workspace:*",
    "@selftune/harness-codex": "workspace:*",
    "@selftune/harness-core": "workspace:*",
    "@selftune/harness-openclaw": "workspace:*",
    "@selftune/harness-opencode": "workspace:*",
    "@selftune/harness-pi": "workspace:*",
    "@selftune/local": "workspace:*",
    "@selftune/orchestration": "workspace:*",
    "@selftune/runtime": "workspace:*",
    "@selftune/telemetry-contract": "workspace:*",
    "effect": "4.0.0-beta.66",
    "react-markdown": "^10.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0",
    "@effect/vitest": "4.0.0-beta.66",
    "@evilmartians/lefthook": "^1.13.6",
    "@types/bun": "^1.3.11",
    "bun-types": "^1.3.11",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "turbo": "^2.5.6",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18"
  },
  "bundledDependencies": [
    "@selftune/control-plane",
    "@selftune/harness-claude-code",
    "@selftune/harness-cline",
    "@selftune/harness-codex",
    "@selftune/harness-core",
    "@selftune/harness-openclaw",
    "@selftune/harness-opencode",
    "@selftune/harness-pi",
    "@selftune/local",
    "@selftune/orchestration",
    "@selftune/runtime",
    "@selftune/telemetry-contract"
  ],
  "packageManager": "bun@1.3.14"
}
